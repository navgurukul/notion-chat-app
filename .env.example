# NextAuth configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# AWS Bedrock Knowledge Base (RAG)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your_s3_bucket_name
AWS_KNOWLEDGE_BASE_ID=your_knowledge_base_id
AWS_DATA_SOURCE_ID=your_data_source_id

# Optional: retrieval tuning
# Standard Q&A retrieval
AWS_RETRIEVAL_RESULTS_PER_QUERY=10
AWS_RETRIEVAL_MAX_CONTEXT_CHARS=32000

# High-recall retrieval (used automatically for owner/creator list/count queries)
AWS_RETRIEVAL_HIGH_RECALL_RESULTS_PER_QUERY=25
AWS_RETRIEVAL_HIGH_RECALL_MAX_QUERIES=6
AWS_RETRIEVAL_HIGH_RECALL_MAX_CONTEXT_CHARS=32000
AWS_RETRIEVAL_HIGH_RECALL_MAX_CHUNK_CHARS=900

# Notion configuration
NOTION_TOKEN=your_notion_integration_token

# AI configuration
# Supported providers: gemini, deepseek
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# Optional: enable debug endpoints in production. Keep false unless actively debugging.
ENABLE_DEBUG_ROUTES=false
