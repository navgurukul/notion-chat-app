# NextAuth configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL + pgvector (app reads DATABASE_URL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/notion_chat
# POSTGRES_URL=postgresql://postgres:password@localhost:5432/notion_chat

# Optional: semantic search tuning
VECTOR_SEARCH_TOP_K=20
VECTOR_SEARCH_MIN_SIMILARITY=0.3
VECTOR_SEARCH_MAX_CONTEXT_CHARS=32000

# Notion configuration
NOTION_TOKEN=your_notion_integration_token

# OpenAI embeddings (sync + search). Set false to sync without vectors (FTS still works).
OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Max chars per embed input (OpenAI limit ~8192 tokens). Default 28000.
# OPENAI_EMBEDDING_MAX_CHARS=28000
EMBEDDINGS_ENABLED=false

# Backfill vectors after sync (no Notion calls): npm run embed:missing
# EMBED_BATCH_LIMIT=50
# EMBED_TARGET=chunks,pages

# AI configuration (chat uses OpenAI; embeddings also use OpenAI)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Simple + accurate defaults (leave commented = use built-in defaults):
# - QUERY_REFORMULATION: ON — follow-ups like "who owns it?"
# - AI_INTENT_CLASSIFIER: ON — LLM routing beats regex for messy questions
# - MMR: ON, MMR_LAMBDA=0.85 — less duplicate chunks
# - MULTI_QUERY_RAG: OFF — enable later for broad multi-topic questions only
# After OpenAI credits: EMBEDDINGS_ENABLED=true then npm run embed:missing

# History-aware RAG: LLM rewrites follow-up questions before retrieval (default: on)
# QUERY_REFORMULATION=false

# LLM intent router (default: on)
# AI_INTENT_CLASSIFIER=false

# v2 Multi-Query RAG (optional — extra LLM call per question)
# MULTI_QUERY_RAG=true
# MULTI_QUERY_COUNT=3

# Chunking (structure-aware recursive split; re-sync after changing)
# CHUNK_TARGET_CHARS=1800
# CHUNK_OVERLAP_CHARS=350

# Retrieval diversity (MMR — reduces redundant chunks)
# MMR_ENABLED=true
# MMR_LAMBDA=0.85
# RETRIEVAL_MAX_CHUNKS_PER_PAGE=2
# HYBRID_CHUNK_CANDIDATES=60
# HYBRID_CHUNK_TOP_K=7
# Evidence gate before LLM (hybrid final_score 0–1)
# RETRIEVAL_MIN_TOP_SCORE=0.1
# RETRIEVAL_MIN_AVG_SCORE=0.06
# RETRIEVAL_STRONG_TOP_SCORE=0.22
# RETRIEVAL_MIN_CHUNKS=2
# CHAT_DEBUG=true
