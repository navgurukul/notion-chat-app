# NextAuth configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL (local or remote)
# Local example: postgresql://postgres:password@localhost:5432/notion_chat
POSTGRES_URL=postgresql://user:password@localhost:5432/notion_chat

# AWS S3 — used only for reading existing Notion JSON exports during sync
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your_s3_bucket_name
S3_NOTION_PREFIX=notion/pages/

# Notion configuration
NOTION_TOKEN=your_notion_integration_token

# AI configuration
# Supported providers: gemini, deepseek
AI_PROVIDER=deepseek
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# Vector search tuning (optional)
VECTOR_SEARCH_TOP_K=10
VECTOR_SEARCH_MIN_SIMILARITY=0.3
VECTOR_SEARCH_MAX_CONTEXT_CHARS=24000
